# --- private career docs: NEVER commit (this repo is public) ---
# Leading slash = repo root ONLY. Without it, `0*.md` also matched
# lessons/001-*.md and silently excluded the whole lessons folder. See
# lessons/errors.md E9.
/0*.md
/tennis-questions.yml
career-files-claude/

# --- secrets ---
.env
.env.*
!.env.example

# --- data (re-downloadable from source; keeps the repo small) ---
data/*
!data/.gitkeep

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- dbt ---
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# --- dagster ---
.dagster/
dagster_home/
tmp*/

# --- tool scratch ---
.playwright-mcp/

# --- os / editor ---
.DS_Store
.idea/
.vscode/

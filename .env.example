# Copy to .env and adjust. docker compose reads this file too.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=tennis
POSTGRES_USER=tennis
POSTGRES_PASSWORD=tennis

# Where downloaded Match Charting Project CSVs land
DATA_DIR=data/raw

# Match Charting Project mirror (override to pin a fork/commit for reproducibility)
MCP_BASE_URL=https://raw.githubusercontent.com/JeffSackmann/tennis_MatchChartingProject/master

# --- Layer 2 (unused in Increment 0, here so the shape is visible) ---
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000

# Agent LLM (Increment 2). Gemini via langchain-google-genai; see
# src/deuce/agent/llm.py. LLM_MODEL has no default on purpose (D6).
# GOOGLE_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite

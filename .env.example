# Copy to .env and adjust. docker compose reads this file too.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=tennis
POSTGRES_USER=tennis
POSTGRES_PASSWORD=tennis

# Where downloaded Match Charting Project CSVs land
DATA_DIR=data/raw

# Match Charting Project mirror (override to pin a fork/commit for reproducibility)
MCP_BASE_URL=https://raw.githubusercontent.com/JeffSackmann/tennis_MatchChartingProject/master

